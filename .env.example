# WebHound environment configuration.
# Copy to .env and fill in your values.

# ---- repo ----
REPO_ROOT="/Users/prettysorrow/Desktop/web-hound-go"

# ---- postgres ----
POSTGRES_USER="postgres-user"
POSTGRES_PASSWORD="..."
POSTGRES_DB="postgres-db"

POSTGRES_SERVICE="postgres-server"
POSTGRES_CONTAINER="go-postgres-server"
MIGRATE_SERVICE="postgres-migrate"
MIGRATE_CONTAINER="go-postgres-migrate"
PGWEB_SERVICE="pgweb"

POSTGRES_HOST_PATH="/Users/prettysorrow/Desktop/web-hound-go/postgres-db"
POSTGRES_DOCKER_PATH="/var/lib/postgresql"
MIGRATE_HOST_PATH="/Users/prettysorrow/Desktop/web-hound-go/postgres-migrations"
MIGRATE_DOCKER_PATH="/migrations"

POSTGRES_HOST_PORT="5432"
POSTGRES_DOCKER_PORT="5432"
PGWEB_PORT="8082"

# ---- backend (go) ----
BACKEND_SERVER_HOST="localhost"
BACKEND_SERVER_PORT="8080"

# ---- fetching (python) ----
FETCHING_SERVER_HOST="127.0.0.1"
FETCHING_SERVER_PORT="8090"

# ---- frontend (react) ----
VITE_BACKEND_API_URL="http://localhost:8080"
VITE_USE_TESTING_DATA="false"

# ---- secrets ----
INSTAGRAM_LOGIN="..."
INSTAGRAM_PASSWORD="..."
TELEGRAM_API_ID="..."
TELEGRAM_API_HASH="..."
STEAM_WEB_API_KEY="..."
